# Python FastAPI Backend Configuration (.env)
# Copy this file to backend/.env on your Virtual Machine

PORT=8000
ENVIRONMENT=production

# Allowed CORS origins (Include your Cloudflare Pages domain and custom domains)
CORS_ORIGINS=["https://karnexus.com","https://www.karnexus.com","https://karnexus.pages.dev","http://localhost:3000"]

# Outgoing SMTP Configuration for project enquiries
# If left empty, the API responds with configured=False and instructs the user to email directly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@karnexus.com
SMTP_PASS=your_app_specific_password_here
SMTP_STARTTLS=true

# Email recipients
NOTIFICATION_EMAIL=contact@karnexus.com
FROM_EMAIL=contact@karnexus.com
