{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karnexus",
  "main": "cloudflare-worker/worker.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
